{
  "name": "jable-desktop",
  "version": "0.2.0",
  "description": "Tampermonkey exporter and Electron desktop app for Jable favourites and watch-later lists.",
  "main": "app/main.js",
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "predev:renderer": "npm run check:node",
    "dev:renderer": "vite --config vite.renderer.config.mjs",
    "prebuild:renderer": "npm run check:node",
    "build:renderer": "vite build --config vite.renderer.config.mjs",
    "prestart": "npm run check:node",
    "start": "npm run build:renderer && electron .",
    "prestart:dev": "npm run check:node",
    "start:dev": "JABLE_RENDERER_DEV_URL=http://127.0.0.1:5173 electron .",
    "pretest": "npm run check:node",
    "test": "node --test test/*.test.js",
    "pretest:renderer": "npm run check:node",
    "test:renderer": "vitest run --config vitest.renderer.config.mjs",
    "test:all": "npm test && npm run test:renderer",
    "pack:mac": "npm run build:renderer && electron-builder --mac --dir",
    "pack:win": "npm run build:renderer && electron-builder --win --dir --x64",
    "dist:mac": "npm run build:renderer && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:mac:unsigned": "npm run build:renderer && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis zip --x64 --publish never",
    "dist:win:unsigned": "npm run build:renderer && electron-builder --win nsis zip --x64 --publish never"
  },
  "keywords": [
    "electron",
    "jable",
    "sqlite",
    "tampermonkey"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "electron": "^41.5.1",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "vue": "^3.5.34"
  },
  "build": {
    "appId": "io.github.shane-zeng.jable-desktop",
    "productName": "Jable Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "!app/renderer-src/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "dmg": {
      "artifactName": "Jable-Desktop-${version}-${arch}.${ext}"
    },
    "artifactName": "Jable-Desktop-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=24.0.0 <26.0.0"
  }
}
