{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "app",
    "outDir": "app/runtime-dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["app/**/*.ts"],
  "exclude": ["app/renderer-dist", "app/renderer-src", "app/runtime-dist", "node_modules", "release"]
}
