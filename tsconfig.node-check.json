{
  "compilerOptions": {
    "target": "ES2024",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["app/browser-tab-policy.js", "app/i18n/index.js", "app/sync-utils.js", "app/update-checker.js"],
  "exclude": ["app/renderer-dist", "node_modules", "release"]
}
